{
    "name": "infrangible/m2-catalog-product-pos-hyva",
    "description": "Makes the point-of-sale display of Catalog Product POS work in stores that use the Hyvä theme: attribute value, hidden add-to-cart button and custom button.",
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä",
        "Catalog",
        "Hyvä support for Catalog Product POS",
        "in-store only products for Hyvä"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-pos-hyva",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-pos": "~1.1.0",
        "infrangible/m2-catalog-product-swatches-hyva": "~1.0.0",
        "infrangible/m2-core": "~2.15.1||~3.14.1||~4.0.1",
        "hyva-themes/magento2-compat-module-fallback": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPOSHyva\\": "src"
        }
    }
}
